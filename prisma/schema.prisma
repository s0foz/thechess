// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  email           String?  @unique
  passwordHash    String
  rating          Int      @default(1200)
  xp              Int      @default(0)
  level           Int      @default(1)
  wins            Int      @default(0)
  losses          Int      @default(0)
  draws           Int      @default(0)
  puzzlesSolved   Int      @default(0)
  pieces          Int      @default(50) // currency, starts with 50
  ownedSkins      String   @default("[]") // JSON array of skin IDs
  ownedTitles     String   @default("[]") // JSON array of title IDs
  activePieceSkin String   @default("default")
  activeBoardSkin String   @default("default")
  activeTitle     String?  // null = no title equipped
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  gamesWhite Game[] @relation("WhitePlayer")
  gamesBlack Game[] @relation("BlackPlayer")
}

model Game {
  id        String    @id @default(cuid())
  whiteId   String
  blackId   String
  white     User      @relation("WhitePlayer", fields: [whiteId], references: [id])
  black     User      @relation("BlackPlayer", fields: [blackId], references: [id])
  moves     String    @default("[]") // JSON array of SAN moves
  result    String    @default("ongoing") // "ongoing" | "white" | "black" | "draw"
  reason    String?   // "checkmate" | "resign" | "timeout" | "draw_agreement" | "abandon"
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([whiteId])
  @@index([blackId])
  @@index([createdAt])
}
